---
export const prerender = false

import DeepLink from "@/layouts/deep-link.astro"
import { getListByShortCode } from "@/lib/convex"

const { code, joinCode } = Astro.params
const safeCode = (code ?? "").trim()
const safeJoin = (joinCode ?? "").trim()
const list = safeCode ? await getListByShortCode(safeCode) : null

const title = list?.name ?? "Collaborate on a Vesper list"
const ownerLine = list?.owner
  ? ` by ${list.owner.displayName} (@${list.owner.username})`
  : ""
const itemsLine =
  list && list.itemCount > 0
    ? ` · ${list.itemCount} ${list.itemCount === 1 ? "title" : "titles"}`
    : ""
const description = list
  ? `Join as editor on ${list.name}${ownerLine}${itemsLine}`
  : "Open Vesper to join this list as an editor."
const descPrefix = list
  ? `Join as editor on ${list.name}`
  : "Join this list as an editor"
const descSuffix = list && list.itemCount > 0 ? itemsLine : ""
const openUrl = `vesper://join/${encodeURIComponent(safeJoin)}`
const path = `/list/${safeCode}/join/${safeJoin}`
---

<DeepLink
  eyebrow="Join list"
  title={title}
  description={description}
  descPrefix={descPrefix}
  descSuffix={descSuffix}
  owner={list?.owner ?? undefined}
  openUrl={openUrl}
  path={path}
  posters={list?.previewPosters ?? []}
  coverKind={list?.kind}
  coverSeed={list?._id ?? safeCode}
/>
