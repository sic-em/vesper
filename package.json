{
  "name": "vesper-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "concurrently -k -n electron,convex -c cyan,magenta \"pnpm --filter @vesper/desktop dev\" \"convex dev\"",
    "dev:desktop": "pnpm --filter @vesper/desktop dev",
    "splash": "pnpm --filter @vesper/desktop splash",
    "dev:site": "pnpm --filter @vesper/site dev",
    "dev:convex": "convex dev",
    "build": "pnpm -r build",
    "build:desktop": "pnpm --filter @vesper/desktop build",
    "build:site": "pnpm --filter @vesper/site build",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "convex": "^1.39.1",
    "prettier": "^3.0.0"
  },
  "dependencies": {
    "@auth/core": "0.37.0",
    "@convex-dev/auth": "^0.0.92",
    "@convex-dev/presence": "^0.3.0",
    "@convex-dev/rate-limiter": "^0.3.2",
    "files-sdk": "^1.5.0",
    "nanoid": "^5.1.11"
  }
}
